# Telegram
BOT_TOKEN=123456789:replace-with-real-token
ADMIN_ID=123456789

# PostgreSQL: Docker host is `db`, local runs use `localhost`.
# Test database name MUST end with `_test`.
# SECURITY: jobs:jobs below are PLACEHOLDERS only. On deploy, generate a strong
# unique password (e.g. `openssl rand -base64 24`) and pass it via env/secret store —
# never copy the placeholder credentials from this example (docs/security/report.md F-06).
DATABASE_URL=postgresql+asyncpg://jobs:jobs@db:5432/jobs
TEST_DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs_test

# Scheduler
COLLECT_INTERVAL_MINUTES=60
DIGEST_SIZE_DEFAULT=10
DIGEST_CATCHUP_MINUTES=180

# Retention: vacancies older than N days are purged at CLEANUP_TIME (UTC).
RETENTION_DAYS=30
CLEANUP_TIME=04:15

# HTTP client (collectors)
HTTP_TIMEOUT_SECONDS=20
